<!DOCTYPE html>
<html>
  <head>
    <title>ShareSuke</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-73N436WHW1"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-73N436WHW1');
    </script>
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  </head>

  <body>
    <%= render 'shared/header' %>
      <div id="flash-messages-container" class="fixed inset-x-0 top-16 flex justify-center z-50 mr-10">
        <%= turbo_frame_tag 'flash', class: "flex w-full flex-col items-center space-y-4 sm:items-end" do %>
          <% flash.each do |key, massage| %>
            <%= render "layouts/flash/message_summarize" %>
          <% end %>
        <% end %>
      </div>
    <%= yield %>
    
    <%= render 'shared/footer' %>
  </body>
</html>
