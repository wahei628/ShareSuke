<div class="container px-5">
  <h1><%= @event.title %></h1>
  <%= render 'events/schedule_table', event: @event, users: @users %>

  <%= form_with(model: [@event, @user], local: true) do |form| %>
    <div>
      <%= form.label :name, "名前" %>
      <%= form.text_field :name, class: "bg-gray-100 text-black border border-gray-300 rounded" %>
    </div>
    <div>
      <%= form.submit "更新する", class: "bg-[#5353DA] hover:bg-[#4141B5] text-white font-bold py-1 px-2 rounded-lg mt-2 cursor-pointer" %>
    </div>
  <% end %>

  <%= form_with(url: event_user_path(@event, @user), method: :delete, local: true) do |form| %>
    <div>
      <%= form.submit "削除する", class: "bg-[#FF0000] hover:bg-[#CC0000] text-white font-bold py-1 px-2 rounded-lg mt-2 cursor-pointer" %>
    </div>
  <% end %>
</div>