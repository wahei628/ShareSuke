<div class="ml-10">
  <div class="px-5 pt-10">
    <h2 class="text-3xl font-bold text-gray-800"><%= @event.title %></h2><br>
    <p class="text-lg text-gray-800"><%= @event.description %></p><br>
    <div class="flex items-center">
      <h3 class="overflow-hidden">
        <span id="url">https://sharesuke.onrender.com/events/<%= @event.url_slug %></span>
      </h3>
      <button class="btn btn-xs btn-success text-white flex-grow-0 flex-shrink-0 ml-2" id="url_copy_btn">コピー</button>
      <div class="tooltip tooltip-open tooltip-right hidden mb-2" id="url_done" data-tip="コピーしました！"></div>
    </div>
  </div>
</div>

<div class="pt-7">
  <%= render 'events/schedule_table' %>
</div>

<div>
  <div class="mx-auto px-4 py-8 w-11/12 border pb-10">
    <h2 class="text-2xl" >ユーザー登録</h2><br>
    <%= form_with(model: @user, url: event_users_path(@event), local: true) do |form| %>
      <%= hidden_field_tag :event_url_slug, @event.url_slug %>
      <div class="flex items-center">
        <div class="mx-1">
          <%= form.label :name, "名前" %>
          <%= form.text_field :name, class: "text-black border border-gray-300 rounded" %>
        </div>
        <div class="mx-1">
          <%= form.submit "新規登録", class: "bg-[#FC7400] hover:bg-[#FF9500] text-white font-bold py-1 px-2 rounded-lg cursor-pointer"%>
        </div>
      </div>
    <% end %>

    <%= render 'events/comment_area' %>
  </div>
</div>
