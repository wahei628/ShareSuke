<div class="flex items-center justify-center m-8">
  <div class="max-w-md w-full">
    <h1 class="card-title text-center text-2xl mb-6">イベント新規作成</h1>
    <%= form_with model: @event, url: events_path, local: true do |f| %>
      <div class="mb-4">
        <%= f.label :title, "タイトル", class: "block mb-1" %>
        <%= f.text_field :title, class: "input input-bordered w-full p-2" %>
      </div>

      <div class="mb-4">
        <%= f.label :description, "内容", class: "block mb-1" %>
        <%= f.text_field :description, class: "input input-bordered w-full p-2" %>
      </div>

      <div class="mb-4">
        <%= f.label :dates, '日付', class: "block mb-1"%>
        <%= f.hidden_field :dates %>          
        <div id="react-calendar-form" class="p-2"></div>
      </div>

      <div class="mb-4">
        <%= f.label :password, "合言葉 ※任意", class: "block mb-1" %>
        
        <div class = "flex items-center my-3">
          <%= f.password_field :password, id: 'password-field', class: "input input-bordered w-full p-2" %>
          <button type="button" class="btn btn-xs btn-success text-white ml-2" id="password_copy_btn">コピー</button>
          <div class="tooltip tooltip-open tooltip-right hidden mb-2" id="password_tooltip" data-tip="コピーしました！"></div>
          <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-circle btn-ghost text-info">
              <svg
                tabindex="0"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                class="h-4 w-4 stroke-current">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div
              tabindex="0"
              class="card compact dropdown-content bg-base-100 rounded-box z-[1] w-64 shadow">
              <div tabindex="0" class="card-body">
                <h2 class="card-title">合言葉はアクセス時に必要になります</h2>
                <p> コピーボタンを押してクリップボードにコピーしておきましょう </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-6 text-center">
        <%= f.submit "イベントページを作成する", class: "btn bg-[#FC7400] hover:bg-[#FF9500] text-white shadow-xl cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

<%= javascript_include_tag "password" %>