<!DOCTYPE html>
<html>
<head>
  <title>New Event</title>
</head>

<div class="flex items-center justify-center m-[20px] p-[10px]">
  <div class="card-body shadow-2xl">
    <h1 class="card-title">イベント新規作成</h1>
    <%= form_with model: @event, url:events_path, local: true do |f| %>
      <div>
        <%= f.label :title, "タイトル" %>
        <div class="input input-bordered w-full max-w-xs">
          <%= f.text_field :title %>
        </div>
      </div>
      <br/>
      <div>
        <%= f.label :description, "内容" %>
        <div class="input input-bordered w-full max-w-xs">
          <%= f.text_field :description %>
        </div>
      </div>
      <br/>
      <div>
      <br/>
      <div class="mr-24">
        <%= f.label :dates, '日付'%>
        <%= f.hidden_field :dates %>          
          <div id="react-calendar-form"></div>
      </div>
      </div>
      <br/>
      <div>
        <%= f.label :password, "合言葉" %>
        <div class="input input-bordered w-full max-w-xs">
          <%= f.password_field :password, id: 'password-field' %>
        </div>
      </div>

      <div class="flex items-center my-3">
        <h1>パスワード設定値: </h1>
        <p id="password" class="flex-grow-0 flex-shrink-0 font-bold px-2"></p>
        <button type="button" class="btn btn-xs btn-success flex-grow-0 flex-shrink-0" id="password_copy_btn">コピー</button>
        <div class="tooltip tooltip-open tooltip-right hidden mb-2" id="password_tooltip" data-tip="コピーしました！"></div>
      </div>

      <br/>
      <br/>
      <br/>
      <button type="submit" class="btn border border-blue-200 hover:bg-cyan-100">
        <%= f.submit "イベントページを作成する", class: "cursor-pointer"%>
      </button>
    <% end %>
  </div>
</div>

<%= javascript_include_tag "password" %>

</body>
</html>

