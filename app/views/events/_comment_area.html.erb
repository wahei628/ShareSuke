<div class = "my-5">
  <h3 class = "text-2xl">コメント</h3>
  <br>
  <div id="comments" data-event-id="<%= @event.id %>" class="border overflow-auto h-[calc(45vh-2rem)]">
    <% @comments.each do |comment| %>
      <%= render partial: 'comments/comment', locals: { comment: comment } %>
    <% end %>
  </div>

  <div class="my-5">
    <h3>コメントをする（ユーザー名をクリック後コメントを投稿）</h3>
    <div class="flex my-5 flex-wrap">
      <% @event.users.each do |user| %>
        <div class="relative">
        <button type="button" class="btn-xs select-user btn bg-[#5353DA] hover:bg-[#4141B5] text-white mx-1" data-user-id="<%= user.id %>" data-user-name="<%= user.name %>"><%= user.name %></button>
        </div>
      <% end %>
    </div>

    <%= form_with(model: Comment.new, url: event_comments_path(@event), local: true, id: 'comment_form') do |form| %>
      <%= hidden_field_tag :user_id, nil, id: 'user_id_field' %>
      <div>
        <%= form.text_area :body, class: "text-black border border-gray-300 rounded p-2 w-1/3" %>
      </div>
      <div>
        <button class="btn btn-xs bg-[#FC7400] hover:bg-[#FF9500] text-white flex-grow-0 flex-shrink-0">コメント投稿</button>
    <% end %>
  </div>
</div>

<%= javascript_include_tag "comment" %>